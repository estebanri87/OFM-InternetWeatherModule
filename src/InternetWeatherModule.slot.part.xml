          <Dynamic>
            <ChannelIndependentBlock>
              <ParameterBlock Id="%AID%_PB-nnn" Name="Slot">
                <ParameterBlock Id="%AID%_PB-nnn" Name="f%CC%IWSlot%SL%" Text="Wetter %SL%: {{0: ...}}" TextParameterRefId="%AID%_P-%TT%%CC%%SPP+0%_R-%TT%%CC%%SPP+0%01" Icon="gauge" ShowInComObjectTree="true" HelpContext="IW-SlotLabel">
                  <ParameterRefRef RefId="%AID%_P-%TT%%CC%%SPP+0%_R-%TT%%CC%%SPP+0%01" HelpContext="IW-SlotLabel" />
                  <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+1%_R-%TT%%CC%%SPP+1%01" HelpContext="IW-SlotKategorie" />
                  <!-- Schattenparameter muss im Dynamic mindestens einmal referenziert sein -->
                  <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+13%_R-%TT%%CC%%SPP+13%01" />

                  <!-- (1) Kategorie blendet die passende Messwert-Sicht ein und kopiert sie in den Schattenparameter -->
                  <choose ParamRefId="%AID%_UP-%TT%%CC%%SPP+1%_R-%TT%%CC%%SPP+1%01">
                    <when test="1">
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+5%_R-%TT%%CC%%SPP+5%01" HelpContext="IW-SlotMesswert" />
                      <Assign TargetParamRefRef="%AID%_UP-%TT%%CC%%SPP+13%_R-%TT%%CC%%SPP+13%01" SourceParamRefRef="%AID%_UP-%TT%%CC%%SPP+5%_R-%TT%%CC%%SPP+5%01" />
                    </when>
                    <when test="2">
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+6%_R-%TT%%CC%%SPP+6%01" HelpContext="IW-SlotMesswert" />
                      <Assign TargetParamRefRef="%AID%_UP-%TT%%CC%%SPP+13%_R-%TT%%CC%%SPP+13%01" SourceParamRefRef="%AID%_UP-%TT%%CC%%SPP+6%_R-%TT%%CC%%SPP+6%01" />
                    </when>
                    <when test="3">
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+7%_R-%TT%%CC%%SPP+7%01" HelpContext="IW-SlotMesswert" />
                      <Assign TargetParamRefRef="%AID%_UP-%TT%%CC%%SPP+13%_R-%TT%%CC%%SPP+13%01" SourceParamRefRef="%AID%_UP-%TT%%CC%%SPP+7%_R-%TT%%CC%%SPP+7%01" />
                    </when>
                    <when test="4">
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+8%_R-%TT%%CC%%SPP+8%01" HelpContext="IW-SlotMesswert" />
                      <Assign TargetParamRefRef="%AID%_UP-%TT%%CC%%SPP+13%_R-%TT%%CC%%SPP+13%01" SourceParamRefRef="%AID%_UP-%TT%%CC%%SPP+8%_R-%TT%%CC%%SPP+8%01" />
                    </when>
                    <when test="5">
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+9%_R-%TT%%CC%%SPP+9%01" HelpContext="IW-SlotMesswert" />
                      <Assign TargetParamRefRef="%AID%_UP-%TT%%CC%%SPP+13%_R-%TT%%CC%%SPP+13%01" SourceParamRefRef="%AID%_UP-%TT%%CC%%SPP+9%_R-%TT%%CC%%SPP+9%01" />
                    </when>
                    <when test="6">
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+10%_R-%TT%%CC%%SPP+10%01" HelpContext="IW-SlotMesswert" />
                      <Assign TargetParamRefRef="%AID%_UP-%TT%%CC%%SPP+13%_R-%TT%%CC%%SPP+13%01" SourceParamRefRef="%AID%_UP-%TT%%CC%%SPP+10%_R-%TT%%CC%%SPP+10%01" />
                    </when>
                    <when test="7">
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+11%_R-%TT%%CC%%SPP+11%01" HelpContext="IW-SlotMesswert" />
                      <Assign TargetParamRefRef="%AID%_UP-%TT%%CC%%SPP+13%_R-%TT%%CC%%SPP+13%01" SourceParamRefRef="%AID%_UP-%TT%%CC%%SPP+11%_R-%TT%%CC%%SPP+11%01" />
                    </when>
                    <when test="8">
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+12%_R-%TT%%CC%%SPP+12%01" HelpContext="IW-SlotMesswert" />
                      <Assign TargetParamRefRef="%AID%_UP-%TT%%CC%%SPP+13%_R-%TT%%CC%%SPP+13%01" SourceParamRefRef="%AID%_UP-%TT%%CC%%SPP+12%_R-%TT%%CC%%SPP+12%01" />
                    </when>
                  </choose>

                  <!-- (2) Offset-Einheit je Zeitebene; Typ/Aggregation nur bei aggregierbaren Groessen -->
                  <choose ParamRefId="%AID%_UP-%TT%%CC%%SPP+13%_R-%TT%%CC%%SPP+13%01">
                    <when test="17 32 38 48 51 64 68 72 80 84 88 96 120" />
                    <when test="16 19 35 36 37 41 42 43 67 71 75 83 87 91 93 99 100 101 102 122 129">
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+14%_R-%TT%%CC%%SPP+14%01" HelpContext="IW-SlotOffset" />
                      <choose ParamRefId="%AID%_UP-%TT%%CC%%SPP+13%_R-%TT%%CC%%SPP+13%01">
                        <when test="16 19 75 101 102" />
                        <when default="true">
                          <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+2%_R-%TT%%CC%%SPP+2%01" HelpContext="IW-SlotTyp" />
                          <choose ParamRefId="%AID%_UP-%TT%%CC%%SPP+2%_R-%TT%%CC%%SPP+2%01">
                            <when test="1">
                              <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+17%_R-%TT%%CC%%SPP+17%01" HelpContext="IW-SlotOffsetBis" />
                              <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+3%_R-%TT%%CC%%SPP+3%01" HelpContext="IW-SlotAggregation" />
                            </when>
                          </choose>
                        </when>
                      </choose>
                    </when>
                    <when test="18 34 40 50 52 66 70 74 82 86 90 92 97 98 113 115 117 119 121 128">
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+15%_R-%TT%%CC%%SPP+15%01" HelpContext="IW-SlotOffset" />
                      <choose ParamRefId="%AID%_UP-%TT%%CC%%SPP+13%_R-%TT%%CC%%SPP+13%01">
                        <when test="18 74" />
                        <when default="true">
                          <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+2%_R-%TT%%CC%%SPP+2%01" HelpContext="IW-SlotTyp" />
                          <choose ParamRefId="%AID%_UP-%TT%%CC%%SPP+2%_R-%TT%%CC%%SPP+2%01">
                            <when test="1">
                              <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+18%_R-%TT%%CC%%SPP+18%01" HelpContext="IW-SlotOffsetBis" />
                              <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+3%_R-%TT%%CC%%SPP+3%01" HelpContext="IW-SlotAggregation" />
                            </when>
                          </choose>
                        </when>
                      </choose>
                    </when>
                    <when test="33 39 49 65 69 73 81 85 89 112 114 116 118">
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+16%_R-%TT%%CC%%SPP+16%01" HelpContext="IW-SlotOffset" />
                      <choose ParamRefId="%AID%_UP-%TT%%CC%%SPP+13%_R-%TT%%CC%%SPP+13%01">
                        <when test="73" />
                        <when default="true">
                          <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+2%_R-%TT%%CC%%SPP+2%01" HelpContext="IW-SlotTyp" />
                          <choose ParamRefId="%AID%_UP-%TT%%CC%%SPP+2%_R-%TT%%CC%%SPP+2%01">
                            <when test="1">
                              <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+19%_R-%TT%%CC%%SPP+19%01" HelpContext="IW-SlotOffsetBis" />
                              <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+3%_R-%TT%%CC%%SPP+3%01" HelpContext="IW-SlotAggregation" />
                            </when>
                          </choose>
                        </when>
                      </choose>
                    </when>
                  </choose>

                  <!-- (3) Sendeverhalten und das zum Messwert passende Kommunikationsobjekt -->
                  <choose ParamRefId="%AID%_UP-%TT%%CC%%SPP+13%_R-%TT%%CC%%SPP+13%01">
                    <when test="0" />
                    <when default="true">
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%%SPP+4%_R-%TT%%CC%%SPP+4%01" HelpContext="IW-SlotSenden" />
