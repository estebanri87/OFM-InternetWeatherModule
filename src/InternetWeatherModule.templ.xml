<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_14/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer"
  xmlns="http://knx.org/xml/project/14" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">
  <ManufacturerData>
    <Manufacturer>
      <ApplicationPrograms>
        <ApplicationProgram>

          <!-- Ein Wetter-Kanal steht für einen Ort und hat drei frei belegbare
               Wert-Slots (Wetter A/B/C). Das Fragment wird einmal gepflegt und
               vom Producer dreimal expandiert.
                 %SL%  Slot-Buchstabe A/B/C
                 %SO%  Byte-Offset des Slots im Kanalblock (9 / 15 / 21)
                 %SPP% Basis der Parameter-IDs des Slots (100 / 140 / 180)
                 %SK%  KO-Index des Slots innerhalb des Kanals (1 / 2 / 3) -->
          <op:part name="SLOT" href="InternetWeatherModule.slot.part.xml" instances="3">
            <op:param name="%SL%"  value="0"   increment="1"  asLetter="true" />
            <op:param name="%SO%"  value="9"   increment="6" />
            <op:param name="%SPP%" value="100" increment="40" digits="3" />
            <op:param name="%SK%"  value="1"   increment="1" />
          </op:part>

          <Static>
            <Parameters>
              <!-- Beschreibung: kein Union, keine Memory -> nur in der ETS, nicht auf dem Gerät -->
              <Parameter Id="%AID%_P-%TT%%CC%000" Name="Channel%C%Name" ParameterType="%AID%_PT-Text40Byte" Text="Beschreibung" Value="" />

              <!-- Kanalkopf, 9 Byte:
                   Byte 0   Bit 3-0 Wetter-Service, Bit 4 Suspendiert, Bit 5 Ortswahl
                   Byte 1-4 Latitude, Byte 5-8 Longitude -->
              <Union SizeInBit="72">
                <Memory CodeSegment="%MID%" Offset="0" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%001" Name="CH%C%WeatherChannelType"  ParameterType="%AID%_PT-WeatherChannelType"  Offset="0" BitOffset="0" Text="Wetter-Service" Value="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%002" Name="CH%C%Suspended"           ParameterType="%AID%_PT-Suspended"           Offset="0" BitOffset="4" Text="Suspendiert" Value="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%003" Name="CH%C%WeatherLocationType" ParameterType="%AID%_PT-WeatherLocationType" Offset="0" BitOffset="5" Text="Ort" Value="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%004" Name="CH%C%Latitude"            ParameterType="%AID%_PT-Latitude"            Offset="1" BitOffset="0" Text="Breitengrad" Value="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%005" Name="CH%C%Longitude"           ParameterType="%AID%_PT-Longitude"           Offset="5" BitOffset="0" Text="Längengrad" Value="0" />
              </Union>

              <!-- TypeSelect: kein Union, keine Memory-Referenz -> nur in der ETS gespeichert.
                   Auf dem Kanal-Tab wird nur der Dienst gewechselt, nie deaktiviert. -->
              <Parameter Id="%AID%_P-%TT%%CC%997" Name="Ch%C%TypeSelect" ParameterType="%AID%_PT-WeatherChannelTypeSelect" Text="Wetter-Service" Value="2" />

              <!-- Anzeigename für den Kanal-Tab: Beschreibung, der bei "Suspendiert = Ja"
                   das Zeichen der Kanalauswahl vorangestellt wird. Nur in der ETS. -->
              <Parameter Id="%AID%_P-%TT%%CC%998" Name="Ch%C%NameDisplay" ParameterType="%AID%_PT-Text45Byte" Text="Beschreibung (Anzeige)" Value="" Access="Read" op:configTransfer="never" />

              <!-- Wetter A/B/C -->
              <op:usePart name="SLOT" xpath="//Parameters/*" />
            </Parameters>

            <ParameterRefs>
              <ParameterRef Id="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" RefId="%AID%_P-%TT%%CC%000" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101" RefId="%AID%_UP-%TT%%CC%001" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%002_R-%TT%%CC%00201" RefId="%AID%_UP-%TT%%CC%002" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%003_R-%TT%%CC%00301" RefId="%AID%_UP-%TT%%CC%003" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%004_R-%TT%%CC%00401" RefId="%AID%_UP-%TT%%CC%004" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%005_R-%TT%%CC%00501" RefId="%AID%_UP-%TT%%CC%005" />
              <ParameterRef Id="%AID%_P-%TT%%CC%997_R-%TT%%CC%99701" RefId="%AID%_P-%TT%%CC%997" />
              <ParameterRef Id="%AID%_P-%TT%%CC%998_R-%TT%%CC%99801" RefId="%AID%_P-%TT%%CC%998" />

              <op:usePart name="SLOT" xpath="//ParameterRefs/*" />
            </ParameterRefs>

            <!-- Wetter-Service zwischen Kanalauswahl und Kanal-Tab synchronisieren.
                 Das input.TypeValue > 0 - Guard in BASE_SyncChannelType sorgt dafür, dass
                 "Deaktiviert" aus der Tabelle den gemerkten Dienst nicht überschreibt. -->
            <ParameterCalculations>
              <ParameterCalculation Id="%AID%_PC-%TT%%CC%001" Language="JavaScript" Name="SyncType%CC%"
                                    RLTransformationFunc="BASE_SyncChannelType" LRTransformationFunc="BASE_SyncChannelType">
                <LParameters>
                  <ParameterRefRef RefId="%AID%_P-%TT%%CC%997_R-%TT%%CC%99701" AliasName="TypeValue" />
                </LParameters>
                <RParameters>
                  <ParameterRefRef RefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101" AliasName="TypeValue" />
                </RParameters>
              </ParameterCalculation>

              <!-- Suspendierte Kanäle in der Baumansicht kennzeichnen -->
              <ParameterCalculation Id="%AID%_PC-%TT%%CC%002" Language="JavaScript" Name="MarkInactive%CC%"
                                    RLTransformationFunc="BASE_MarkInactiveChannel" RLTransformationParameters="{&quot;InactiveValue&quot;:1}"
                                    LRTransformationFunc="BASE_Nop">
                <LParameters>
                  <ParameterRefRef RefId="%AID%_P-%TT%%CC%998_R-%TT%%CC%99801" AliasName="TextOutput" />
                </LParameters>
                <RParameters>
                  <ParameterRefRef RefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" AliasName="TextInput" />
                  <ParameterRefRef RefId="%AID%_UP-%TT%%CC%002_R-%TT%%CC%00201" AliasName="InactiveControl" />
                </RParameters>
              </ParameterCalculation>
            </ParameterCalculations>

            <ComObjectTable>
              <!-- Diagnose: HTTP-Statuscode des letzten Abrufs -->
              <ComObject Id="%AID%_O-%TT%%CC%000" Number="%K0%" Name="CH%C%HTTPStatus" Text="" ObjectSize="2 Bytes" DatapointType="DPST-8-1" FunctionText="" ReadFlag="Enabled" WriteFlag="Disabled" CommunicationFlag="Enabled" TransmitFlag="Enabled" UpdateFlag="Disabled" ReadOnInitFlag="Disabled" />

              <op:usePart name="SLOT" xpath="//ComObjectTable/*" />
            </ComObjectTable>

            <ComObjectRefs>
              <ComObjectRef Id="%AID%_O-%TT%%CC%000_R-%TT%%CC%00001" RefId="%AID%_O-%TT%%CC%000" Name="CH%C%HTTPStatus" Text="{{0:Wetter %C%}}: Diagnose HTTP" FunctionText="Wetter %C%: Ausgang, HTTP-Statuscode" TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" Priority="Low" />

              <op:usePart name="SLOT" xpath="//ComObjectRefs/*" />
            </ComObjectRefs>
          </Static>

          <Dynamic>
            <ChannelIndependentBlock>

              <!-- Eine Zeile der Kanalauswahl-Tabelle. Je Kanal eine eigene Inline-Tabelle,
                   das rendert in der ETS deutlich schneller als eine große Tabelle. -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Settings">
                <ParameterBlock Id="%AID%_PB-nnn" Inline="true" Layout="Grid">
                  <Rows><Row Id="%AID%_PB-nnn_R-1" /></Rows>
                  <Columns>
                    <Column Id="%AID%_PB-nnn_C-1" Width="10%" />
                    <Column Id="%AID%_PB-nnn_C-2" Width="35%" />
                    <Column Id="%AID%_PB-nnn_C-3" Width="55%" />
                  </Columns>
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,1" Text="Wetter %C%" />
                  <!-- Haupttyp: memory-backed, mit "Deaktiviert" - nur hier wird ein Kanal aktiviert -->
                  <ParameterRefRef RefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101" Cell="1,2" HelpContext="IW-WetterService" />
                  <!-- Beschreibung ohne choose-Wrapper: bleibt auch bei Deaktiviert sichtbar -->
                  <ParameterRefRef RefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" Cell="1,3" HelpContext="BASE-ChannelName" />
                </ParameterBlock>
              </ParameterBlock>

              <!-- Kanal-Tab, nur bei gewähltem Wetter-Service -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Channel">
                <choose ParamRefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101">
                  <when test="&gt;0">
                    <ParameterBlock Id="%AID%_PB-nnn" Name="f%CC%IW" Text="Wetter %C%: {{0: ...}}" TextParameterRefId="%AID%_P-%TT%%CC%998_R-%TT%%CC%99801" Icon="weather-partly-cloudy" HelpContext="IW-Service" ShowInComObjectTree="true">

                      <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanaldefinition" UIHint="Headline" />
                      <ParameterRefRef RefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" IndentLevel="1" HelpContext="BASE-ChannelName" />
                      <!-- TypeSelect: ohne "Deaktiviert", synchron zur Kanalauswahl -->
                      <ParameterRefRef RefId="%AID%_P-%TT%%CC%997_R-%TT%%CC%99701" IndentLevel="1" HelpContext="IW-WetterService" />
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%002_R-%TT%%CC%00201" IndentLevel="1" HelpContext="BASE-ChannelSuspended" />

                      <!-- Dienstspezifische Hinweise -->
                      <choose ParamRefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101">
                        <when test="1">
                          <ParameterSeparator Id="%AID%_PS-nnn" Text="One Call 3.0 erfordert ein Abonnement und einen API Key.&#10;Der API Key wird auf der Seite 'Basiseinstellungen' hinterlegt." UIHint="Information" />
                        </when>
                        <when test="2">
                          <choose ParamRefId="%AID%_UP-%TT%00020_R-%TT%0002001">
                            <when test="0">
                              <ParameterSeparator Id="%AID%_PS-nnn" Text="Nutzung/Lizenz muss ausgewählt werden zur Verwendung von Open-Meteo!&#10;Hinweis: Die Einstellung kann auf der Seite 'Basiseinstellungen' vorgenommen werden." UIHint="Error" />
                            </when>
                            <when default="true">
                              <ParameterSeparator Id="%AID%_PS-nnn" Text="Weather data by Open-Meteo.com (https://open-meteo.com/)&#10;&#10;Creative-Commons-Lizenz: Attribution 4.0 International (CC BY 4.0)&#10;Datenquellen und genaue Nutzungsbedingungen siehe https://open-meteo.com/en/license" UIHint="Information" />
                            </when>
                          </choose>
                        </when>
                      </choose>

                      <!-- Standort -->
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%003_R-%TT%%CC%00301" HelpContext="IW-WeatherLocationType" />
                      <choose ParamRefId="%AID%_UP-%TT%%CC%003_R-%TT%%CC%00301">
                        <when test="1">
                          <ParameterRefRef RefId="%AID%_UP-%TT%%CC%004_R-%TT%%CC%00401" IndentLevel="1" HelpContext="IW-Latitude" />
                          <ParameterRefRef RefId="%AID%_UP-%TT%%CC%005_R-%TT%%CC%00501" IndentLevel="1" HelpContext="IW-Longitude" />
                        </when>
                      </choose>

                      <!-- Diagnose -->
                      <ComObjectRefRef RefId="%AID%_O-%TT%%CC%000_R-%TT%%CC%00001" />

                      <!-- Wetter A/B/C -->
                      <op:usePart name="SLOT" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='Slot']/*" />

                    </ParameterBlock>
                  </when>
                </choose>
              </ParameterBlock>

            </ChannelIndependentBlock>
          </Dynamic>

        </ApplicationProgram>
      </ApplicationPrograms>
    </Manufacturer>
  </ManufacturerData>
</KNX>
