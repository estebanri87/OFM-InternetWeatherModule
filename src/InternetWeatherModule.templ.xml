<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_14/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer"
  xmlns="http://knx.org/xml/project/14" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">
  <ManufacturerData>
    <Manufacturer>
      <ApplicationPrograms>
        <ApplicationProgram>

          <!-- Ein Wetter-Kanal hat drei frei belegbare Wert-Slots (Wetter A/B/C).
               Das Fragment wird einmal gepflegt und vom Producer dreimal expandiert.
                 %SL%  Slot-Buchstabe A/B/C
                 %SO%  Byte-Offset des Slots im Kanalblock (9 / 15 / 21)
                 %SPP% Basis der Parameter-IDs des Slots (100 / 130 / 160)
                 %SK%  KO-Index des Slots innerhalb des Kanals (1 / 2 / 3) -->
          <op:part name="SLOT" href="InternetWeatherModule.slot.part.xml" instances="3">
            <op:param name="%SL%"  value="0"   increment="1"  asLetter="true" />
            <op:param name="%SO%"  value="9"   increment="6" />
            <op:param name="%SPP%" value="100" increment="30" digits="3" />
            <op:param name="%SK%"  value="1"   increment="1" />
          </op:part>

          <Static>
            <Parameters>
              <!-- Beschreibung: kein Union, keine Memory -> nur in der ETS, nicht auf dem Geraet -->
              <Parameter Id="%AID%_P-%TT%%CC%000" Name="Channel%C%Name" ParameterType="%AID%_PT-Text40Byte" Text="Beschreibung" Value="" />

              <!-- Kanalkopf, 9 Byte:
                   Byte 0  Bit 0 Aktiv, Bit 1 Suspendiert, Bit 2 Ortswahl
                   Byte 1-4 Latitude, Byte 5-8 Longitude -->
              <Union SizeInBit="72">
                <Memory CodeSegment="%MID%" Offset="0" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%001" Name="CH%C%Active"             ParameterType="%AID%_PT-IWChannelActive"    Offset="0" BitOffset="0" Text="Wetter-Kanal" Value="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%002" Name="CH%C%Suspended"          ParameterType="%AID%_PT-Suspended"          Offset="0" BitOffset="1" Text="Suspendiert" Value="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%003" Name="CH%C%WeatherLocationType" ParameterType="%AID%_PT-WeatherLocationType" Offset="0" BitOffset="2" Text="Ort" Value="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%004" Name="CH%C%Latitude"           ParameterType="%AID%_PT-Latitude"           Offset="1" BitOffset="0" Text="Breitengrad" Value="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%005" Name="CH%C%Longitude"          ParameterType="%AID%_PT-Longitude"          Offset="5" BitOffset="0" Text="Längengrad" Value="0" />
              </Union>

              <!-- Wetter A/B/C -->
              <op:usePart name="SLOT" xpath="//Parameters/*" />
            </Parameters>

            <ParameterRefs>
              <ParameterRef Id="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" RefId="%AID%_P-%TT%%CC%000" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101" RefId="%AID%_UP-%TT%%CC%001" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%002_R-%TT%%CC%00201" RefId="%AID%_UP-%TT%%CC%002" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%003_R-%TT%%CC%00301" RefId="%AID%_UP-%TT%%CC%003" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%004_R-%TT%%CC%00401" RefId="%AID%_UP-%TT%%CC%004" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%005_R-%TT%%CC%00501" RefId="%AID%_UP-%TT%%CC%005" />

              <op:usePart name="SLOT" xpath="//ParameterRefs/*" />
            </ParameterRefs>

            <ComObjectTable>
              <!-- Diagnose: HTTP-Statuscode des letzten Abrufs -->
              <ComObject Id="%AID%_O-%TT%%CC%000" Number="%K0%" Name="CH%C%HTTPStatus" Text="" ObjectSize="2 Bytes" DatapointType="DPST-8-1" FunctionText="" ReadFlag="Enabled" WriteFlag="Disabled" CommunicationFlag="Enabled" TransmitFlag="Enabled" UpdateFlag="Disabled" ReadOnInitFlag="Disabled" />

              <op:usePart name="SLOT" xpath="//ComObjectTable/*" />
            </ComObjectTable>

            <ComObjectRefs>
              <ComObjectRef Id="%AID%_O-%TT%%CC%000_R-%TT%%CC%00001" RefId="%AID%_O-%TT%%CC%000" Name="CH%C%HTTPStatus" Text="{{0:Wetter %C%}}: Diagnose HTTP" FunctionText="Wetter %C%: Ausgang, HTTP-Statuscode" TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" Priority="Low" />

              <op:usePart name="SLOT" xpath="//ComObjectRefs/*" />
            </ComObjectRefs>
          </Static>

          <Dynamic>
            <ChannelIndependentBlock>

              <!-- Eine Zeile der Kanalauswahl-Tabelle. Je Kanal eine eigene Inline-Tabelle,
                   das rendert in der ETS deutlich schneller als eine grosse Tabelle. -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Settings">
                <ParameterBlock Id="%AID%_PB-nnn" Inline="true" Layout="Grid">
                  <Rows><Row Id="%AID%_PB-nnn_R-1" /></Rows>
                  <Columns>
                    <Column Id="%AID%_PB-nnn_C-1" Width="15%" />
                    <Column Id="%AID%_PB-nnn_C-2" Width="35%" />
                    <Column Id="%AID%_PB-nnn_C-3" Width="50%" />
                  </Columns>
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,1" Text="Wetter %C%" />
                  <ParameterRefRef RefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101" Cell="1,2" HelpContext="BASE-ChannelSelect" />
                  <!-- Beschreibung ohne choose-Wrapper: bleibt auch bei Deaktiviert sichtbar -->
                  <ParameterRefRef RefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" Cell="1,3" HelpContext="BASE-ChannelName" />
                </ParameterBlock>
              </ParameterBlock>

              <!-- Kanal-Tab, nur bei aktiviertem Kanal -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Channel">
                <choose ParamRefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101">
                  <when test="=1">
                    <ParameterBlock Id="%AID%_PB-nnn" Name="f%CC%IW" Text="Wetter %C%: {{0: ...}}" TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" Icon="weather-partly-cloudy" HelpContext="IW-Service" ShowInComObjectTree="true">

                      <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanaldefinition" UIHint="Headline" />
                      <ParameterRefRef RefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" IndentLevel="1" HelpContext="BASE-ChannelName" />
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%002_R-%TT%%CC%00201" IndentLevel="1" HelpContext="BASE-ChannelSuspended" />

                      <!-- Lizenzhinweis Open-Meteo -->
                      <choose ParamRefId="%AID%_UP-%TT%00020_R-%TT%0002001">
                        <when test="0">
                          <ParameterSeparator Id="%AID%_PS-nnn" Text="Nutzung/Lizenz muss ausgewählt werden zur Verwendung von Open-Meteo!&#10;Hinweis: Die Einstellung kann auf der Seite 'Basiseinstellungen' vorgenommen werden." UIHint="Error" />
                        </when>
                        <when default="true">
                          <ParameterSeparator Id="%AID%_PS-nnn" Text="Weather data by Open-Meteo.com (https://open-meteo.com/)&#10;&#10;Creative-Commons-Lizenz: Attribution 4.0 International (CC BY 4.0)&#10;Datenquellen und genaue Nutzungsbedingungen siehe https://open-meteo.com/en/license" UIHint="Information" />
                        </when>
                      </choose>

                      <!-- Standort -->
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%003_R-%TT%%CC%00301" HelpContext="IW-WeatherLocationType" />
                      <choose ParamRefId="%AID%_UP-%TT%%CC%003_R-%TT%%CC%00301">
                        <when test="1">
                          <ParameterRefRef RefId="%AID%_UP-%TT%%CC%004_R-%TT%%CC%00401" IndentLevel="1" HelpContext="IW-Latitude" />
                          <ParameterRefRef RefId="%AID%_UP-%TT%%CC%005_R-%TT%%CC%00501" IndentLevel="1" HelpContext="IW-Longitude" />
                        </when>
                      </choose>

                      <!-- Diagnose -->
                      <ComObjectRefRef RefId="%AID%_O-%TT%%CC%000_R-%TT%%CC%00001" />

                      <!-- Wetter A/B/C -->
                      <op:usePart name="SLOT" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='Slot']/*" />

                    </ParameterBlock>
                  </when>
                </choose>
              </ParameterBlock>

            </ChannelIndependentBlock>
          </Dynamic>

        </ApplicationProgram>
      </ApplicationPrograms>
    </Manufacturer>
  </ManufacturerData>
</KNX>
